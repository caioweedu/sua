{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "regions": ["gru1"],
  "crons": [
    {
      "path": "/api/keep-alive",
      "schedule": "*/5 12-21 * * 1-5"
    },
    {
      "path": "/api/cron/compliance-notify",
      "schedule": "0 11 * * 1-5"
    }
  ]
}
