// Plataforma de treinamentos white-label (mãe/filha) da Weedu.
//
// Banco: PostgreSQL (Neon/Supabase/RDS em produção). Em runtime a aplicação
// usa DATABASE_URL (conexão com pooler); as migrations usam DIRECT_URL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // URL com pooling (ex.: Neon pooler) — usada pela aplicação em runtime.
  url      = env("DATABASE_URL")
  // URL direta (sem pooler) — usada pelas migrations. Em dev local pode ser
  // igual à DATABASE_URL.
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// MULTI-TENANT (white-label)
// ---------------------------------------------------------------------------
// Um Tenant é uma "universidade corporativa". A mãe (Weedu) é o tenant raiz;
// as filhas (clientes) têm `parentId` apontando para a mãe. Cada tenant tem
// sua própria marca e pode ter um domínio personalizado.

model Tenant {
  id           String  @id @default(cuid())
  name         String
  slug         String  @unique // usado como subdomínio: <slug>.dominio.com
  type         String  @default("DAUGHTER") // "MOTHER" | "DAUGHTER"
  parentId     String?
  parent       Tenant? @relation("TenantHierarchy", fields: [parentId], references: [id])
  children     Tenant[] @relation("TenantHierarchy")

  // Domínio próprio (ex.: universidade.cliente.com.br). Opcional.
  customDomain String? @unique

  // Branding
  brandColor     String  @default("#2563eb")
  brandFgColor   String  @default("#ffffff")
  logoUrl        String?
  // Fundo do certificado (URL de imagem) e texto de assinatura.
  certificateBg  String?
  certificateSignature String?

  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  users    User[]
  trilhas  Trilha[]
  vitrines Vitrine[]
  accessProfiles AccessProfile[]
  // Biblioteca de provas reutilizáveis do tenant.
  exams    Exam[]
  // Condições de liberação (motor de gating unificado, Fase 2).
  releaseConditions ReleaseCondition[]

  // Banner exibido na entrada (topo do painel do aluno).
  bannerUrl String?

  @@index([parentId])
}

// ---------------------------------------------------------------------------
// VITRINES
// ---------------------------------------------------------------------------
// Uma vitrine é uma "área"/loja dentro da universidade (ex.: "Operações",
// "Gestores"). Agrupa produtos (trilhas) e tem imagem/banner próprios.
// O acesso pode ser restrito por perfil (Fase B).

model Vitrine {
  id          String  @id @default(cuid())
  tenantId    String
  tenant      Tenant  @relation(fields: [tenantId], references: [id])
  name        String
  slug        String
  description String?
  coverUrl    String?
  bannerUrl   String?
  published   Boolean @default(true)
  order       Int     @default(0)
  createdAt   DateTime @default(now())

  // Condição de liberação (Fase 2): a vitrine só fica acessível quando a
  // condição é satisfeita. Nulo = sempre liberada.
  releaseConditionId String?
  releaseCondition   ReleaseCondition? @relation(fields: [releaseConditionId], references: [id])

  trilhas Trilha[]
  profiles AccessProfile[]
  // Provas colocadas diretamente na vitrine (avaliação geral da área).
  examPlacements ExamPlacement[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([releaseConditionId])
}

// ---------------------------------------------------------------------------
// PERFIS DE ACESSO
// ---------------------------------------------------------------------------
// Um perfil libera um conjunto de vitrines. O usuário vinculado ao perfil só
// enxerga as vitrines liberadas. Usuário sem perfil vê todas as vitrines
// publicadas (aberto por padrão).

model AccessProfile {
  id          String  @id @default(cuid())
  tenantId    String
  tenant      Tenant  @relation(fields: [tenantId], references: [id])
  name        String
  description String?
  createdAt   DateTime @default(now())

  vitrines Vitrine[]
  users    User[]

  @@index([tenantId])
}

// ---------------------------------------------------------------------------
// USUÁRIOS
// ---------------------------------------------------------------------------
// Papéis: SUPER_ADMIN (Weedu, gerencia tudo), TENANT_ADMIN (gestor da filha),
// STUDENT (aluno). O email é único por tenant.

model User {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  name         String
  email        String
  passwordHash String
  role         String   @default("STUDENT") // SUPER_ADMIN | TENANT_ADMIN | STUDENT
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  // Perfil de acesso (define quais vitrines o aluno enxerga). Nulo = todas.
  accessProfileId String?
  accessProfile   AccessProfile? @relation(fields: [accessProfileId], references: [id])

  enrollments  Enrollment[]
  attempts     ExamAttempt[]
  certificates Certificate[]
  aulaProgress AulaProgress[]

  @@unique([tenantId, email])
  @@index([tenantId])
}

// ---------------------------------------------------------------------------
// PRODUTOS (TRILHAS), MÓDULOS E AULAS
// ---------------------------------------------------------------------------
// Hierarquia: Vitrine → Trilha (produto) → Módulo → Aula.
// A trilha (produto) pode ter uma prova ao final e emite certificado.

model Trilha {
  id          String  @id @default(cuid())
  tenantId    String
  tenant      Tenant  @relation(fields: [tenantId], references: [id])
  // Vitrine à qual o produto pertence (nulo = ainda não organizado).
  vitrineId   String?
  vitrine     Vitrine? @relation(fields: [vitrineId], references: [id])
  title       String
  description String?
  coverUrl    String?
  // Categoria legada (substituída por vitrine; mantida por compatibilidade).
  category    String?
  published   Boolean @default(false)
  order       Int     @default(0)
  createdAt   DateTime @default(now())

  // Condição de liberação (Fase 2): este produto só fica acessível quando a
  // condição é satisfeita. Nulo = sempre liberado.
  releaseConditionId String?
  releaseCondition   ReleaseCondition? @relation(fields: [releaseConditionId], references: [id])

  modulos     Modulo[]
  aulas       Aula[]
  // Provas colocadas neste produto (prova final do produto).
  examPlacements ExamPlacement[]
  enrollments Enrollment[]
  certificates Certificate[]

  @@index([tenantId])
  @@index([vitrineId])
  @@index([releaseConditionId])
}

// Módulo agrupa aulas dentro de um produto.
model Modulo {
  id        String  @id @default(cuid())
  trilhaId  String
  trilha    Trilha  @relation(fields: [trilhaId], references: [id], onDelete: Cascade)
  title     String
  order     Int     @default(0)

  // Condição de liberação (Fase 2): o módulo só abre quando satisfeita.
  releaseConditionId String?
  releaseCondition   ReleaseCondition? @relation(fields: [releaseConditionId], references: [id])

  aulas     Aula[]
  // Provas colocadas ao fim deste módulo (checkpoint do módulo).
  examPlacements ExamPlacement[]

  @@index([trilhaId])
  @@index([releaseConditionId])
}

model Aula {
  id          String  @id @default(cuid())
  // Aula pertence a um módulo. trilhaId é mantido (denormalizado) para
  // consultas diretas e compatibilidade.
  trilhaId    String
  trilha      Trilha  @relation(fields: [trilhaId], references: [id], onDelete: Cascade)
  moduloId    String?
  modulo      Modulo? @relation(fields: [moduloId], references: [id], onDelete: Cascade)
  title       String
  description String?
  // O vídeo é hospedado fora (YouTube, Vimeo, Panda, etc). Guardamos só o link.
  videoUrl    String?
  pdfUrl      String?
  order       Int     @default(0)

  progress    AulaProgress[]

  @@index([trilhaId])
  @@index([moduloId])
}

// Conclusão de aula por aluno (B2). Serve para calcular o progresso da trilha
// e para liberar a prova só depois que todas as aulas forem concluídas.
model AulaProgress {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  aulaId      String
  aula        Aula     @relation(fields: [aulaId], references: [id], onDelete: Cascade)
  completedAt DateTime @default(now())

  @@unique([userId, aulaId])
  @@index([userId])
  @@index([aulaId])
}

// ---------------------------------------------------------------------------
// BIBLIOTECA DE PROVAS + COLOCAÇÃO (Fase 1)
// ---------------------------------------------------------------------------
// A prova (`Exam`) é um item da BIBLIOTECA do tenant: banco de questões +
// regras de correção, neutro (não sabe onde é usado). Uma `ExamPlacement`
// insere essa prova num container (vitrine, produto ou módulo) — a mesma prova
// pode ser reutilizada em vários lugares, e cada colocação tem a sua ordem e
// condição de liberação. Na Fase 2 a condição vira um motor genérico
// (ReleaseCondition); por ora a colocação carrega `requireAllLessons`.
//
// A cada tentativa o sistema sorteia `questionsToShow` do banco (ex.: 20
// cadastradas, mostra 6).

model Exam {
  id             String @id @default(cuid())
  // Tenant dono da prova (a prova vive na biblioteca do tenant).
  tenantId       String
  tenant         Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title          String @default("Avaliação final")
  questionsToShow Int   @default(6)  // quantas questões sortear por tentativa
  passingScore   Int    @default(70) // % mínimo para aprovação
  maxAttempts    Int    @default(0)  // 0 = ilimitado
  shuffleOptions Boolean @default(true)  // embaralhar as alternativas
  showAnswers    Boolean @default(false) // mostrar o gabarito ao final
  createdAt      DateTime @default(now())

  questions  Question[]
  attempts   ExamAttempt[]
  placements ExamPlacement[]

  @@index([tenantId])
}

// Colocação de uma prova num container. Exatamente UM de vitrineId/trilhaId/
// moduloId é preenchido — é onde a prova aparece para o aluno.
model ExamPlacement {
  id       String  @id @default(cuid())
  examId   String
  exam     Exam    @relation(fields: [examId], references: [id], onDelete: Cascade)

  // Container (exatamente um):
  vitrineId String?
  vitrine   Vitrine? @relation(fields: [vitrineId], references: [id], onDelete: Cascade)
  trilhaId  String?
  trilha    Trilha?  @relation(fields: [trilhaId], references: [id], onDelete: Cascade)
  moduloId  String?
  modulo    Modulo?  @relation(fields: [moduloId], references: [id], onDelete: Cascade)

  order    Int     @default(0)
  required Boolean @default(true)
  // Condição de liberação (Fase 2): a prova só abre quando satisfeita.
  releaseConditionId String?
  releaseCondition   ReleaseCondition? @relation(fields: [releaseConditionId], references: [id])
  createdAt DateTime @default(now())

  attempts ExamAttempt[]

  @@index([examId])
  @@index([vitrineId])
  @@index([trilhaId])
  @@index([moduloId])
  @@index([releaseConditionId])
}

// ---------------------------------------------------------------------------
// MOTOR DE CONDIÇÃO DE LIBERAÇÃO (Fase 2)
// ---------------------------------------------------------------------------
// Uma condição é anexada a um item (vitrine, produto, módulo ou colocação de
// prova) via `releaseConditionId`. O item só fica liberado quando a condição é
// satisfeita. Os alvos são ids "soltos" (sem FK) para permitir referência
// cruzada em qualquer lugar da vitrine e para o motor tolerar alvos removidos
// (nunca travar o aluno permanentemente por um alvo apagado).
//
// Tipos (campo `type`):
//   AFTER_ALL_LESSONS      — concluir todas as aulas do container do item
//                            (ou de targetModuloId/targetTrilhaId, se informado)
//   AFTER_EXAM_PASSED      — ser aprovado na prova targetExamPlacementId
//                            (com nota mínima opcional em minScore)
//   AFTER_MODULE_COMPLETED — concluir o módulo targetModuloId (aulas + prova)
//   AFTER_TRILHA_COMPLETED — concluir o produto targetTrilhaId
//   AFTER_PERCENT          — concluir `percent`% das aulas do produto
//   AFTER_DAYS             — passar `days` dias desde a matrícula
model ReleaseCondition {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type     String

  // Alvos (conforme o tipo) — ids soltos, sem chave estrangeira.
  targetExamPlacementId String?
  targetModuloId        String?
  targetTrilhaId        String?

  minScore Int?
  percent  Int?
  days     Int?
  createdAt DateTime @default(now())

  // Itens que usam esta condição (na prática 1:1 por item).
  vitrines       Vitrine[]
  trilhas        Trilha[]
  modulos        Modulo[]
  examPlacements ExamPlacement[]

  @@index([tenantId])
}

model Question {
  id        String   @id @default(cuid())
  examId    String
  exam      Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  statement String
  order     Int      @default(0)
  options   QuestionOption[]

  @@index([examId])
}

model QuestionOption {
  id         String   @id @default(cuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  text       String
  isCorrect  Boolean  @default(false)

  @@index([questionId])
}

// ---------------------------------------------------------------------------
// MATRÍCULA, TENTATIVAS E CERTIFICADO
// ---------------------------------------------------------------------------

model Enrollment {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  trilhaId  String
  trilha    Trilha   @relation(fields: [trilhaId], references: [id], onDelete: Cascade)
  status    String   @default("IN_PROGRESS") // IN_PROGRESS | COMPLETED
  createdAt DateTime @default(now())

  @@unique([userId, trilhaId])
  @@index([userId])
}

model ExamAttempt {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  examId    String
  exam      Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  // Colocação em que a tentativa foi feita (define o contexto: produto/módulo/
  // vitrine). Nulo apenas para tentativas antigas anteriores à Fase 1.
  placementId String?
  placement   ExamPlacement? @relation(fields: [placementId], references: [id], onDelete: SetNull)
  score     Int      // percentual acertado (0-100)
  passed    Boolean
  // Respostas do aluno em JSON (stringificado para compatibilidade com SQLite).
  answers   String
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([examId])
  @@index([placementId])
}

model Certificate {
  id           String   @id @default(cuid())
  code         String   @unique // código público de validação
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  trilhaId     String
  trilha       Trilha   @relation(fields: [trilhaId], references: [id], onDelete: Cascade)
  // Snapshot dos dados no momento da emissão (para o certificado não mudar depois).
  studentName  String
  trilhaTitle  String
  issuedAt     DateTime @default(now())

  @@index([userId])
}
