# Banco de dados PostgreSQL.
# - DATABASE_URL: conexão COM pooler (usada pela aplicação em runtime).
#     No Neon, é a string marcada como "Pooled connection" (host com "-pooler").
# - DIRECT_URL: conexão DIRETA sem pooler (usada pelas migrations).
#     No Neon, é a "Direct connection".
# Em dev local as duas podem ser iguais.
DATABASE_URL="postgresql://user:pass@host-pooler.neon.tech/sua?sslmode=require"
DIRECT_URL="postgresql://user:pass@host.neon.tech/sua?sslmode=require"

# Segredo usado para assinar a sessão (JWT em cookie httpOnly).
# Gere um valor forte, ex: openssl rand -base64 32
AUTH_SECRET="troque-por-um-segredo-forte-em-producao"

# Segredo para popular o banco uma vez via /api/seed?secret=...
# Deixe em branco em produção depois de popular, para desativar a rota.
SEED_SECRET=""

# Domínio raiz usado para resolver subdomínios das filhas em desenvolvimento.
# Em produção, cada tenant pode ter um domínio próprio cadastrado no banco.
ROOT_DOMAIN="localhost:3000"

# --- Professor virtual (IA) ---
# Chave da API da Anthropic (https://console.anthropic.com). Sem ela, o
# professor virtual fica indisponível, mas o resto da plataforma funciona.
ANTHROPIC_API_KEY=""
# Modelo usado pelo professor virtual. Padrão: claude-opus-5 (mais capaz).
# Para alto volume de alunos, um modelo mais econômico pode compensar, ex:
# claude-sonnet-5 (equilíbrio) ou claude-haiku-4-5 (mais barato/rápido).
PROFESSOR_MODEL="claude-opus-5"

# --- Envio de e-mail (convite/redefinição de senha) ---
# Provedor: Resend (https://resend.com). Sem estas variáveis, o convite/
# redefinição ainda funcionam, mas o sistema apenas gera um LINK para o admin
# copiar e enviar manualmente (não dispara e-mail automático).
# RESEND_API_KEY: chave em https://resend.com/api-keys
# EMAIL_FROM: remetente verificado no Resend, ex: "Weedu <acesso@seudominio.com>"
RESEND_API_KEY=""
EMAIL_FROM=""

# --- Monitoramento de erros (Sentry) ---
# Sem o DSN, o Sentry fica desligado e o app roda normal. Com o DSN definido,
# erros de servidor e de cliente são reportados (só em produção).
# NEXT_PUBLIC_SENTRY_DSN: DSN do projeto em https://sentry.io (Settings > Client Keys).
NEXT_PUBLIC_SENTRY_DSN=""
# Opcionais — só para upload de source maps (stack traces legíveis no Sentry):
# SENTRY_ORG, SENTRY_PROJECT e um SENTRY_AUTH_TOKEN. Sem eles o build roda igual.
SENTRY_ORG=""
SENTRY_PROJECT=""
